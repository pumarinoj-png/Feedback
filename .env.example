# Copia este archivo a .env.local SOLO para desarrollo local (no lo subas a GitHub).
# En Vercel, define estas variables en: Project Settings → Environment Variables.

# Obligatoria: tu API key de Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Opcionales: modelos a usar (por defecto claude-sonnet-5-5 en ambos)
# CHAT_MODEL=claude-sonnet-5-5
# FEEDBACK_MODEL=claude-sonnet-5-5
